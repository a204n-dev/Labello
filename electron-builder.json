{
  "appId": "com.labello.vocal.workstation",
  "productName": "Labello",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "extraMetadata": {
    "main": "electron/main.cjs"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Labello Vocal Workstation",
    "uninstallDisplayName": "Labello Vocal Workstation",
    "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
  },
  "portable": {
    "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
  }
}
