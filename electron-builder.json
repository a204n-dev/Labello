{
  "appId": "com.vlabeler.next.workstation",
  "productName": "VLabeler Next - Vocal Labeling Workstation",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "extraMetadata": {
    "main": "electron/main.cjs"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "VLabeler Next Workstation",
    "uninstallDisplayName": "VLabeler Next Workstation",
    "installerIcon": "public/favicon.ico",
    "uninstallerIcon": "public/favicon.ico",
    "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
  },
  "portable": {
    "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
  }
}
